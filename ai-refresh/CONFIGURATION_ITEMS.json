    {"class": "S2", "name": "Linked terminology / doc change", "definition": "Multiple docs share the term; no engine/schema impact."},
    {"class": "S3", "name": "Interface or AI-current-state change", "definition": "Affects AI loaders, current-state claims, protocol pointers. Requires DCP."},
    {"class": "S4", "name": "Engine/schema/verification baseline change", "definition": "Affects runtime output, schema, expected results. Requires DCP + traceability + tests."},
