    {"id": "HCC-R003", "name": "Discovery enters as investigation", "text": "Every substantial new concept, defect, external-model suggestion, or architecture change enters through the Investigation Catalog or a Discovery Change Packet before it becomes public doctrine."},
    {"id": "HCC-R004", "name": "Archive is preserved", "text": "Historical AI_REFRESH narratives, cross-check archives, falsified hypotheses, and old push records are not deleted. They are marked historical and excluded from live-current consistency rules."},
    {"id": "HCC-R005", "name": "Ripple requires impact map", "text": "Any change of severity S3 or higher requires an impact map listing affected files, interfaces, controlled values, and verification checks."},
    {"id": "HCC-R006", "name": "Claim changes require evidence", "text": "Any upgrade from candidate or staged to canonical or confirmed must cite the evidence artifact, test, corpus result, external validation, or review packet that justifies promotion."},
    {"id": "HCC-R007", "name": "Current-state files must agree", "text": "Live AI-facing current-state files must not contradict HS_FAST_REFRESH.json on live facts."},
    {"id": "HCC-R008", "name": "Human governs release", "text": "Claude may implement and validate in the working repo, but Peter controls canonical commit, push, and public release."}
  ],

