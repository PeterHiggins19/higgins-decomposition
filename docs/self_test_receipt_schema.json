{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PeterHiggins19/higgins-decomposition/blob/main/docs/self_test_receipt_schema.json",
  "title": "Hs Engine Self-Test Receipt",
  "description": "Dated, hash-signed receipt produced by an Hs engine self-test run. Conforms to STP-1.0 protocol. See docs/SELF_TEST_PROTOCOL.md.",
  "type": "object",
  "required": [
    "self_test_protocol_version",
    "engine",
    "engine_version",
    "schema_version",
    "engine_content_sha256_at_test_time",
    "corpus_id",
    "corpus_sha256",
    "expected_results_sha256",
    "run_timestamp",
    "run_environment",
    "test_results",
    "summary",
    "previous_receipt_sha256",
    "receipt_sha256"
  ],
  "additionalProperties": false,
  "properties": {
    "self_test_protocol_version": {
      "type": "string",
      "const": "STP-1.0"
    },
    "engine": {
      "type": "string",
      "description": "Engine identifier, e.g., 'HCI-CNQ' or 'HCI-CNT'."
    },
    "engine_version": {
      "type": "string",
      "description": "Engine version string, e.g., '2.0.0'."
    },
    "schema_version": {
      "type": "string"
    },
    "engine_content_sha256_at_test_time": {
      "type": ["string", "null"],
      "description": "SHA-256 hex of the engine source file(s) at test time. Null if not computable (e.g., engine running from a packaged install without source access)."
    },
    "corpus_id": {
      "type": "string",
      "description": "Corpus identifier, e.g., 'cnq_corpus/1.0'."
    },
    "corpus_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "SHA-256 of the standard_test_matrices.json file used in this run."
    },
    "expected_results_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "SHA-256 of the expected_results.json file used in this run."
    },
    "run_timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 UTC timestamp of when the run started."
    },
    "run_environment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "git_sha": { "type": ["string", "null"] },
        "python_version": { "type": "string" },
        "numpy_version": { "type": "string" },
        "platform": { "type": "string" },
        "hostname_hash": { "type": "string" },
        "engine_implementation": {
          "type": "string",
          "enum": ["python", "r"]
        }
      }
    },
    "test_results": {
      "type": "array",
      "items": { "$ref": "#/$defs/test_result" }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_tests",
        "passed",
        "failed",
        "skipped",
        "duration_ms",
        "aggregate_verdict"
      ],
      "properties": {
        "total_tests": { "type": "integer", "minimum": 0 },
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "aggregate_verdict": {
          "type": "string",
          "enum": ["ALL_PASS", "SOME_FAILED", "SOME_SKIPPED", "INFRASTRUCTURE_FAIL"]
        }
      }
    },
    "previous_receipt_sha256": {
      "type": ["string", "null"],
      "description": "SHA-256 of the most recent prior receipt for this engine. Null only for the very first receipt."
    },
    "receipt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Self-hash of this receipt (canonical-JSON SHA-256 of the receipt with the 'receipt_sha256' field omitted)."
    }
  },
  "$defs": {
    "test_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["test_id", "verdict", "wall_clock_ms", "checks", "warnings"],
      "properties": {
        "test_id": { "type": "string" },
        "verdict": {
          "type": "string",
          "enum": ["PASS", "FAIL", "SKIP", "ERROR"]
        },
        "wall_clock_ms": { "type": "integer", "minimum": 0 },
        "checks": {
          "type": "array",
          "items": { "$ref": "#/$defs/check_entry" }
        },
        "warnings": { "type": "array", "items": { "type": "string" } },
        "skip_reason": { "type": "string" },
        "error_message": { "type": "string" }
      }
    },
    "check_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "match"],
      "properties": {
        "field": {
          "type": "string",
          "description": "Dot-notation path into the engine output."
        },
        "expected": { "description": "Expected value (for point-value tests)." },
        "expected_min": { "type": "number" },
        "expected_max": { "type": "number" },
        "tolerance_abs": { "type": "number" },
        "tolerance_rel": { "type": "number" },
        "actual": { "description": "Actual value observed in the engine output." },
        "match": { "type": "boolean" },
        "note": { "type": "string" }
      }
    }
  }
}
