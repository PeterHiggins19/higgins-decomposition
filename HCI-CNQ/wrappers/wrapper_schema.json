{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PeterHiggins19/higgins-decomposition/blob/main/HCI-CNQ/wrappers/wrapper_schema.json",
  "title": "CNQ v2 Wrapper Schema",
  "description": "Schema for user-authored data files that translate CNQ engine output into domain-specific localised display names, units, descriptions, and calibration value-range labels. The engine does not load wrappers; a renderer / report-builder tool does. See HCI-CNQ/wrappers/WRAPPER_SCHEMA.md for human-readable specification.",
  "type": "object",
  "required": [
    "wrapper_id",
    "wrapper_version",
    "engine_target",
    "supported_locales",
    "default_locale"
  ],
  "additionalProperties": false,
  "properties": {
    "wrapper_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "description": "Short identifier; lowercase snake_case"
    },
    "wrapper_version": {
      "type": "string",
      "description": "Wrapper version (e.g., '1.0', '2.1.3')"
    },
    "engine_target": {
      "type": "string",
      "description": "Engine + schema version this wrapper is built for (e.g., 'cnq/2.0.0')"
    },
    "supported_locales": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z]{2}$" },
      "minItems": 1,
      "description": "ISO 639-1 two-letter locale codes"
    },
    "default_locale": {
      "type": "string",
      "pattern": "^[a-z]{2}$",
      "description": "Default locale; must be in supported_locales"
    },
    "domain_metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/localized_string" },
        "description": { "$ref": "#/$defs/localized_string" },
        "author": { "type": "string" },
        "references": { "type": "array", "items": { "type": "string" } }
      }
    },
    "t_axis_label": { "$ref": "#/$defs/localized_string" },
    "carrier_aliases": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/alias_entry" }
    },
    "field_aliases": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/alias_entry" }
    },
    "calibration_profiles": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/calibration_profile" }
    }
  },
  "$defs": {
    "localized_string": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": {
        "^[a-z]{2}$": { "type": "string" }
      },
      "additionalProperties": false
    },
    "alias_entry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "display_name": { "$ref": "#/$defs/localized_string" },
        "units": { "type": "string" },
        "description": { "$ref": "#/$defs/localized_string" }
      }
    },
    "calibration_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ranges"],
      "properties": {
        "ranges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["min", "max", "label", "verdict"],
            "additionalProperties": false,
            "properties": {
              "min": { "type": ["number", "null"] },
              "max": { "type": ["number", "null"] },
              "label": { "$ref": "#/$defs/localized_string" },
              "verdict": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
